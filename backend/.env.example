# =====================================================================
# Magnitude Tracker — backend/.env (template)
# =====================================================================
# Copier ce fichier en `backend/.env` sur le serveur de prod et remplir
# les valeurs réelles. Le fichier `.env` est .gitignored.
# =====================================================================

# --- Stockage (legacy, plus utilisé depuis SQLite Phase 4) ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"

# --- CORS ---
# Liste séparée par virgule. "*" autorise tout (OK en self-hosted).
CORS_ORIGINS="*"

# --- Clé API capteur (Phase 1) ---
# Doit correspondre à `SENSOR_KEY` injectée dans le firmware ESP8266 via
# le secret GitHub Actions du repo SQM-Pro-ESP8266.
# Générée automatiquement au 1er boot si absente. NE PAS RÉGÉNÉRER en prod
# sinon les sondes existantes seront rejetées (HTTP 401).
SQM_API_KEY=remplacez-moi-par-une-cle-de-min-32-caracteres-urlsafe

# --- Phase 5 — Auth + 2FA ---
# Compte admin créé au 1er boot si la table users est vide (must_change_password=1).
ADMIN_EMAIL=vous@votre-domaine.fr
ADMIN_PASSWORD=ChoisirUnMotDePasseFortAuMoins12Caracteres

# Cookies httpOnly : 1 en prod (NGINX HTTPS), 0 en dev local HTTP.
COOKIE_SECURE=1

# Clé pour chiffrer les secrets TOTP au repos (Fernet).
# Optionnelle : si vide, fallback sur SQM_API_KEY.
# AUTH_SECRET_KEY=

# --- Phase 6 — Invitations + Emailing ---
# Brevo (primaire) : https://app.brevo.com/settings/keys/api
# Compte gratuit : 300 emails/jour. L'expéditeur DOIT être un sender validé
# dans Brevo (https://app.brevo.com/senders) sinon erreur HTTP 400.
BREVO_API_KEY=xkeysib-...

# Resend (fallback) : https://resend.com/api-keys
# Utilisé si Brevo échoue (4xx/5xx ou network). Compte gratuit : 100/jour.
RESEND_API_KEY=re_...

# Adresse expéditrice (DOIT être validée côté Brevo)
INVITATION_FROM_EMAIL=sqm-pro@votre-domaine.fr
INVITATION_FROM_NAME=SQM Nightwatch

# URL publique utilisée pour construire les liens d'activation dans les emails.
# CRITIQUE : utiliser l'URL réelle accessible publiquement, pas localhost.
INVITATION_PUBLIC_URL=https://magnitude.votre-domaine.fr

# Durée de validité d'un lien d'invitation (heures). 48h par défaut.
INVITATION_TOKEN_TTL_HOURS=48

# --- GitHub (optionnel) ---
# Token pour augmenter le rate-limit du proxy firmware (60→5000 req/h).
# Lecture seule, scope `public_repo` suffit.
# GITHUB_TOKEN=ghp_...

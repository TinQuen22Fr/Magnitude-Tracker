# env.local.example  ── Modèle de configuration locale.
#
# 1. Copier-renommer en `.env.local` :
#       cp deploy/env.local.example deploy/.env.local
#       nano deploy/.env.local
#
# 2. Le fichier `.env.local` est gitignoré → vos valeurs survivent aux pulls.
# 3. Les scripts deploy/install.sh et deploy/enable-http3.sh le sourcent
#    automatiquement s'il existe.

# ============================================================================
# OBLIGATOIRE
# ============================================================================

# Domaine pointant sur ce serveur (A/AAAA DNS configurés)
DOMAIN="sqm.example.com"

# URL du dépôt git (utilisé par install.sh la 1ʳᵉ fois)
REPO_URL="https://github.com/TinQuen22Fr/Magnitude-Tracker.git"

# Branche à déployer (par défaut : Testing)
REPO_BRANCH="Testing"

# ============================================================================
# OPTIONNEL — TLS / Let's Encrypt
# ============================================================================

# Email pour les notifs de renouvellement Let's Encrypt (optionnel)
LETSENCRYPT_EMAIL=""

# ============================================================================
# OPTIONNEL — Système
# ============================================================================

# Dossier d'installation (à laisser tel quel sauf cas particulier)
INSTALL_DIR="/opt/sqm-nightwatch"

# Utilisateur système dédié au service
SERVICE_USER="sqm"

# ============================================================================
# OPTIONNEL — Importer une clé API existante
# ============================================================================
# Décommentez et collez votre clé API SQM existante ici si vous avez DÉJÀ un
# firmware ESP flashé avec une clé. Cela évite d'avoir à reflasher le capteur.
#
# Si vide ou commentée → une nouvelle clé sera auto-générée au démarrage du
# service (visible dans /opt/sqm-nightwatch/backend/.env après install).
#
# ATTENTION : NE JAMAIS commit ce fichier (.env.local) dans le repo public,
#             il contient votre vraie clé API.
#
# SQM_API_KEY_OVERRIDE="votre-cle-api-existante-ici"
